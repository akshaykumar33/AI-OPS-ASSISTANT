{
  "name": "Autonomous AI Media Studio Daily Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://api:8000/studio/trends",
        "options": {}
      },
      "name": "Fetch Viral Trends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/studio/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": \"{{ $json.top_topic }}\",\n  \"format_type\": \"short\",\n  \"language\": \"en\",\n  \"enable_research\": true\n}",
        "options": {}
      },
      "name": "Trigger Studio Video Generation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Viral Trends",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Viral Trends": {
      "main": [
        [
          {
            "node": "Trigger Studio Video Generation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
