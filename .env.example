# Copy this file to .env and fill in real values. Never commit .env itself.

# Gemini API Key - Get a free key (no credit card needed) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default model preference (gemini-2.0-flash, gemini-3.6-flash-high, omni, nano_banana)
GEMINI_MODEL=gemini-2.0-flash

# Chroma persistent storage location (relative to project root)
CHROMA_DB_PATH=./data/chroma

# Optional LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=ai-media-studio
